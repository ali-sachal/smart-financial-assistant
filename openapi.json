  "components": {
    "schemas": {
      "AuthenticatedUser": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          },
          "groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Groups"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "AuthenticatedUser"
      },
      "BillCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Amount Minor"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "default": "USD"
          },
          "category": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Category"
          },
          "kind": {
            "type": "string",
            "enum": [
              "expense",
              "income"
            ],
            "title": "Kind",
            "default": "expense"
          },
          "next_due_date": {
            "type": "string",
            "format": "date",
            "title": "Next Due Date"
