APP_NAME=FastAPI Platform
APP_TAGLINE=Secure and observable REST APIs
APP_VERSION=1.0.0
ENVIRONMENT=local
API_PREFIX=/api

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DATABASE_PORT=5432

AUTH_MODE=local
JWT_SECRET=replace-this-before-production
EXPECTED_AUD=1
ADMIN_OPEN=false

FEATURE_AUTH=true
FEATURE_USERS=true
FEATURE_SUBSCRIPTION=true
FEATURE_PAYMENTS=true
FEATURE_PAYPAL=false
FEATURE_INVOICES=true
FEATURE_EMAIL=true
FEATURE_KAFKA=false
FEATURE_S3=false
FEATURE_TEAMS=false
FEATURE_LLM=false
ENABLED_DOMAINS=example

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
PAYMENT_CURRENCY=usd
INVOICE_BUSINESS_NAME=Example Company
INVOICE_BUSINESS_IDENTIFIER=
INVOICE_BUSINESS_EMAIL=billing@example.com
INVOICE_BUSINESS_ADDRESS=

# Unified AI routing. Profiles are a JSON object using LiteLLM model IDs.
LLM_DEFAULT_MODEL=general
LLM_IMAGE_MODEL=image
LLM_EMBEDDING_MODEL=embedding
LLM_FALLBACK_MODELS=
LLM_PROFILES_JSON=

# Configure only the providers you enable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
KAFKA_SERVER=localhost:9092
KAFKA_EMAIL_TOPIC=email
TEAMS_WEBHOOK_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
S3_usage=false
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
GEMINI_API_KEY=
