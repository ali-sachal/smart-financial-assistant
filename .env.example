APP_NAME=Smart Personal Finance Assistant
APP_TAGLINE=Explainable budgeting, receipt analysis, and cash-flow guidance
APP_VERSION=1.0.0
ENVIRONMENT=local
API_PREFIX=/api

# Flutter/web clients allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Amazon Cognito User Pool access-token verification.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWKS_TTL_SECONDS=3600
CLOCK_SKEW_LEEWAY=10

# Local uses memory. AWS deployments must set this false.
USE_IN_MEMORY_REPOSITORY=true
FINANCE_TABLE_NAME=smart-finance
DYNAMODB_ENDPOINT_URL=
AWS_REGION=us-east-1

# Private receipt storage.
RECEIPTS_BUCKET_NAME=
RECEIPT_MAX_BYTES=10485760
RECEIPT_AUTO_CREATE_CONFIDENCE=0.80

# Gemini receipt extraction and agent tool selection.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
AGENT_MAX_TOOL_ROUNDS=5

# Structured console and date-wise file logging.
LOG_JSON=false
LOG_LEVEL=INFO
LOGS_DIR=logs
